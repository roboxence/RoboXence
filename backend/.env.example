# ROBOXENCE 2026 Backend Environment Variables

# Server Port (Render injects PORT automatically)
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=production

# Comma-separated list of allowed frontend client origins for CORS
ALLOWED_ORIGINS=https://roboxence-2k26.web.app,https://roboxence-2k26.firebaseapp.com,http://localhost:5173

# Optional: Primary Client URL
CLIENT_URL=https://roboxence-2k26.web.app
