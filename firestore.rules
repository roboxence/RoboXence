rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public read-only access to published fest events
    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }
    // Public read-only access to fest general configuration
    match /config/{configId} {
      allow read: if true;
      allow write: if false;
    }
    // Block all other reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
